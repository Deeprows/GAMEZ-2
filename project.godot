; Neon Velocity - Godot 4 3D migration
config_version=5

[application]
config/name="Neon Velocity 3D"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.085, 1)

[input]
steer_left={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":65},{"type":"InputEventKey","physical_keycode":LEFT}]}
steer_right={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":68},{"type":"InputEventKey","physical_keycode":RIGHT}]}
brake={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":83},{"type":"InputEventKey","physical_keycode":DOWN}]}
nitro={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":32}]}
drift={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":SHIFT}]}
pause={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":ESC}]}

[physics]
3d/default_gravity=9.8
3d/default_linear_damp=0.12
3d/default_angular_damp=1.5
